#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q       &kp W             &kp E         &kp R             &kp T                                          &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A       &kp S             &kp D         &kp F             &kp G                                          &kp H        &kp J  &kp K      &kp L    &kp SINGLE_QUOTE
&kp Z       &kp X             &kp C         &kp V             &kp B                                          &kp N        &kp M  &kp COMMA  &kp DOT  &kp MINUS
&kp ESCAPE  &kp LC(LEFT_ALT)  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &mt LEFT_ALT ENTER  &lt 2 TAB  &lt 1 SPACE                             &kp EQUAL
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5                 &kp NUMBER_6    &kp NUMBER_7    &kp NUMBER_8  &kp NUMBER_9     &kp NUMBER_0
&none         &none         &kp DELETE    &kp BACKSPACE  &none                        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none         &none         &kp INSERT    &none          &none                        &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none
&trans        &trans        &trans        &trans         &trans        &trans  &mo 3  &trans                                                         &none
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH  &kp DOLLAR  &kp PERCENT                  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp GRAVE        &kp BACKSLASH  &none     &none       &none                        &none      &kp SEMI       &kp SLASH     &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp TILDE        &kp PIPE       &none     &none       &none                        &none      &kp COLON      &kp QUESTION  &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans           &trans         &trans    &trans      &trans       &trans  &trans  &mo 3                                                         &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &kp PRINTSCREEN                  &bt BT_SEL 0  &none  &none  &none  &sys_reset
&kp F5  &kp F6   &kp F7   &kp F8   &kp SCROLLLOCK                   &bt BT_SEL 1  &none  &none  &none  &soft_off
&kp F9  &kp F10  &kp F11  &kp F12  &kp C_PAUSE                      &bt BT_SEL 2  &none  &none  &none  &none
&trans  &trans   &trans   &trans   &trans           &trans  &trans  &trans                             &bootloader
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &none   &none   &none   &none                   &none   &none      &none  &none      &none
&none   &none   &mo 6   &none   &none                   &none   &mkp LCLK  &mo 5  &mkp RCLK  &mkp MCLK
&none   &none   &none   &none   &none                   &none   &mkp MB4   &none  &mkp MB5   &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                               &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
    };
};
